+            RetrievedChunk {
+                chunk_id: "c2".to_string(),
+                document_id: "d2".to_string(),
+                filename: "doc2.md".to_string(),
+                content: "Tauri is great for desktop apps.".to_string(),
+                score: 0.8,
+                chunk_index: 1,
+            }
