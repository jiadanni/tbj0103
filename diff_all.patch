+        assert_eq!(cosine_similarity(&v1, &v2), 1.0);
+
+        let v1 = vec![1.0, 0.0, 0.0];
+        let v2 = vec![0.0, 1.0, 0.0];
+        assert_eq!(cosine_similarity(&v1, &v2), 0.0);
+
+        let v1 = vec![1.0];
+        let v2 = vec![1.0, 2.0];
+        assert_eq!(cosine_similarity(&v1, &v2), 0.0); // Different lengths
+
+        let v1 = vec![0.0, 0.0];
