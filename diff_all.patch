+    #[test]
+    fn test_build_grounded_prompt() {
+        let chunks = vec![
+            RetrievedChunk {
+                chunk_id: "c1".to_string(),
+                document_id: "d1".to_string(),
+                filename: "doc1.txt".to_string(),
+                content: "This is some test content about rust.".to_string(),
+                score: 0.9,
+                chunk_index: 0,
